<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainContador"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/header_green"
    tools:context=".ContadorActivity">

    <!-- Encabezado Superior -->
    <TextView
        android:id="@+id/tvHeaderContador"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="Contador"
        android:textColor="#2E7D32"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tarjeta Principal Crema -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/card_bg_cream"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderContador">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Valor actual"
                android:textColor="@color/text_dark"
                android:textSize="16sp" />

            <!-- Valor del contador -->
            <TextView
                android:id="@+id/tvValorContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0"
                android:textColor="#3D3846"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="(cuenta del 1 al 20)"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Botón Regresar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegresar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="48dp"
                android:text="Regresar"
                android:textColor="@color/white"
                app:backgroundTint="@color/btn_red"
                app:cornerRadius="28dp" />

            <!-- Botón Iniciar Contador -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciarContador"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Iniciar contador"
                android:textColor="@color/white"
                app:backgroundTint="@color/btn_blue"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>